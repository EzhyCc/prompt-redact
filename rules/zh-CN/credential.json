{
  "locale": "zh-CN",
  "rules": [
    {
      "id": "openai-key",
      "label": "OpenAI 密钥",
      "category": "credential",
      "tier": "format",
      "severity": "high",
      "token": "APIKEY",
      "match": [
        {
          "type": "regex",
          "pattern": "(?<![A-Za-z0-9_-])sk-[A-Za-z0-9_-]{16,256}(?![A-Za-z0-9_-])"
        }
      ],
      "note": "识别 sk- 前缀的长密钥样式并限制长度；可能误报文档中的伪造密钥或示例串。"
    },
    {
      "id": "anthropic-key",
      "label": "Anthropic 密钥",
      "category": "credential",
      "tier": "format",
      "severity": "high",
      "token": "APIKEY",
      "match": [
        {
          "type": "regex",
          "pattern": "(?<![A-Za-z0-9_-])sk-ant-[A-Za-z0-9_-]{16,256}(?![A-Za-z0-9_-])"
        }
      ],
      "note": "识别 sk-ant- 前缀的长密钥样式并限制长度；可能误报文档中的伪造密钥或示例串。"
    },
    {
      "id": "github-token",
      "label": "GitHub 令牌",
      "category": "credential",
      "tier": "format",
      "severity": "high",
      "token": "TOKEN",
      "match": [
        {
          "type": "regex",
          "pattern": "(?<![A-Za-z0-9_])gh[pousr]_[A-Za-z0-9]{20,128}(?![A-Za-z0-9])"
        }
      ],
      "note": "识别 GitHub 令牌前缀及较长随机串；可能误报公开文档中的占位令牌。"
    },
    {
      "id": "aws-access-key",
      "label": "AWS Access Key",
      "category": "credential",
      "tier": "format",
      "severity": "high",
      "token": "TOKEN",
      "match": [
        {
          "type": "regex",
          "pattern": "(?<![A-Z0-9])AKIA[0-9A-Z]{16}(?![A-Z0-9])"
        }
      ],
      "note": "识别 AWS 常见 Access Key ID 结构；该 ID 本身不等同于 Secret Access Key，可能误报示例值。"
    },
    {
      "id": "google-api-key",
      "label": "Google 密钥",
      "category": "credential",
      "tier": "format",
      "severity": "high",
      "token": "APIKEY",
      "match": [
        {
          "type": "regex",
          "pattern": "(?<![A-Za-z0-9])AIza[0-9A-Za-z_-]{35}(?![A-Za-z0-9_-])"
        }
      ],
      "note": "识别常见 Google API key 固定前缀和长度；可能误报公开示例或测试密钥。"
    },
    {
      "id": "slack-token",
      "label": "Slack 令牌",
      "category": "credential",
      "tier": "format",
      "severity": "high",
      "token": "TOKEN",
      "match": [
        {
          "type": "regex",
          "pattern": "(?<![A-Za-z0-9])xox[abprs]-[0-9A-Za-z-]{10,160}(?![A-Za-z0-9-])"
        }
      ],
      "note": "识别 Slack xox 系列令牌；可能误报文档占位串或非真实测试串。"
    },
    {
      "id": "jwt",
      "label": "JWT",
      "category": "credential",
      "tier": "format",
      "severity": "high",
      "token": "JWT",
      "match": [
        {
          "type": "regex",
          "pattern": "(?<![A-Za-z0-9_-])eyJ[A-Za-z0-9_-]{10,2048}[.][A-Za-z0-9_-]{10,2048}[.][A-Za-z0-9_-]{10,2048}(?![A-Za-z0-9_-])"
        }
      ],
      "note": "识别三段式 JWT 外形；不验证签名和 claims，可能误报仿 JWT 的示例字符串。"
    },
    {
      "id": "private-key",
      "label": "PEM 私钥",
      "category": "credential",
      "tier": "format",
      "severity": "high",
      "token": "PRIVATEKEY",
      "match": [
        {
          "type": "regex",
          "pattern": "-----BEGIN ([A-Z ]{0,40}PRIVATE KEY)-----[\\s\\S]{1,8000}?-----END \\1-----"
        }
      ],
      "note": "通过回引用确保 BEGIN/END 的密钥类型一致；内容长度限制为 1–8000 字符。可能误报文档中的示例块，不验证密钥是否真实可用。"
    },
    {
      "id": "password-kv",
      "label": "口令",
      "category": "credential",
      "tier": "format",
      "severity": "high",
      "token": "PASSWORD",
      "match": [
        {
          "type": "regex",
          "pattern": "(?:密码|口令|[Pp]assword|[Pp]asswd|[Pp]wd)[ ]?[:：=][ ]?([^ \\n]{3,64})",
          "valueGroup": 1
        }
      ],
      "note": "由密码关键词锚定，只替换捕获的口令值；可能误报说明文字、示例密码或被标点截断的口令。"
    },
    {
      "id": "db-uri",
      "label": "数据库连接串",
      "category": "credential",
      "tier": "format",
      "severity": "high",
      "token": "DBURI",
      "match": [
        {
          "type": "regex",
          "pattern": "(?:mysql|postgres|postgresql|mongodb|redis|amqp)(?:[+]srv)?://[^ \\n:@/]{1,64}:[^ \\n@/]{1,128}@[^ \\n，。；！？、）】」》]{1,255}"
        }
      ],
      "note": "整段匹配常见含用户名和密码的数据库 URI；可能误报示例连接串，暂不覆盖所有 URI 参数和 IPv6 形式。 库名和查询参数一并吞掉，靠中文标点和换行收尾。"
    },
    {
      "id": "bearer-token",
      "label": "Bearer 令牌",
      "category": "credential",
      "tier": "format",
      "severity": "high",
      "token": "TOKEN",
      "match": [
        {
          "type": "regex",
          "pattern": "[Bb]earer[ ]+[A-Za-z0-9._-]{16,512}(?![A-Za-z0-9._-])"
        }
      ],
      "note": "识别 Bearer 后的长 token；可能误报文档中的示例令牌或测试串。"
    }
  ]
}
