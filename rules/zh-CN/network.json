{
  "locale": "zh-CN",
  "rules": [
    {
      "id": "ipv4",
      "label": "IP 地址",
      "category": "network",
      "tier": "format",
      "severity": "low",
      "token": "IP",
      "match": [
        {
          "type": "regex",
          "pattern": "(?<![0-9.])[0-9]{1,3}(?:[.][0-9]{1,3}){3}(?![0-9.])",
          "validate": "ipv4"
        }
      ],
      "note": "识别点分四段 IPv4 并由 ipv4 校验每段范围；可能误报版本号或普通四段数字，但校验器只排除越界地址。"
    }
  ]
}
