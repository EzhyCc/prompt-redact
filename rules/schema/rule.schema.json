{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://open-privacy.example/schema/rule.schema.json",
  "title": "Open Privacy Rule",
  "description": "Rule contract documentation for Open Privacy v0.0.1; documentation only, not loaded at runtime.",
  "type": "object",
  "required": [
    "id",
    "label",
    "category",
    "tier",
    "severity",
    "token",
    "match"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "contact",
        "identity",
        "credential",
        "finance",
        "network",
        "custom"
      ]
    },
    "tier": {
      "type": "string",
      "enum": [
        "format",
        "semantic"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "token": {
      "type": "string",
      "pattern": "^[A-Z]{2,12}$"
    },
    "match": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "type",
              "pattern"
            ],
            "properties": {
              "type": {
                "const": "regex"
              },
              "pattern": {
                "type": "string"
              },
              "flags": {
                "type": "string"
              },
              "validate": {
                "enum": [
                  "cnMobile",
                  "cnIdCard",
                  "cnUscc",
                  "luhn",
                  "ipv4"
                ]
              },
              "valueGroup": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "const": "literal"
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "note": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
