{
  "name": "prompt-redact",
  "version": "0.0.1",
  "description": "提示词脱敏：在提示词发给 AI 之前，于本地把敏感信息替换为占位符。开源、零依赖、纯本地处理。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./core": "./src/index.js",
    "./rules/*": "./rules/*"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {},
  "bin": {
    "prompt-redact": "tools/cli.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://github.com/EzhyCc/prompt-redact/archive/refs/heads/main.tar.gz",
      "zip": "https://github.com/EzhyCc/prompt-redact/archive/refs/heads/main.zip",
      "git": "https://github.com/EzhyCc/prompt-redact.git"
    }
  },
  "scripts": {
    "test": "node test/selftest.js",
    "demo": "node demo.js",
    "redact": "node tools/cli.js",
    "serve": "node tools/serve.js"
  },
  "files": [
    "src",
    "rules",
    "tools",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "提示词脱敏",
    "prompt-redact",
    "prompt-redaction",
    "prompt-privacy",
    "privacy",
    "redact",
    "sanitize",
    "pii",
    "mask",
    "llm",
    "ai-privacy",
    "本地脱敏",
    "敏感信息",
    "数据脱敏",
    "隐私保护",
    "openai",
    "chatgpt",
    "deepseek"
  ],
  "homepage": "https://github.com/EzhyCc/prompt-redact#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EzhyCc/prompt-redact.git"
  },
  "bugs": {
    "url": "https://github.com/EzhyCc/prompt-redact/issues"
  }
}